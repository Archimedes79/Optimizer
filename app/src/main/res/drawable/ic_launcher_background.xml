<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: deep teal gradient matching the app's primary color.
     Geometry is mirrored by tools/generate_icons.py for the legacy raster icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF14A3A8" />
                <item android:offset="0.55" android:color="#FF0D7377" />
                <item android:offset="1.0" android:color="#FF06393B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Barely-there chart gridlines, for depth on large surfaces. -->
    <path
        android:pathData="M24,44h58 M24,58h58 M24,72h58"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.10"
        android:strokeWidth="0.8" />
</vector>
