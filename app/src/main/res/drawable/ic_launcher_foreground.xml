<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a fan of colored asset price lines with the bold
     portfolio index line running through them, ending on the optimum marker.
     Geometry is mirrored by tools/generate_icons.py for the legacy raster icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Individual securities -->
    <path
        android:pathData="M24,72 L35.6,76 L47.2,66 L58.8,68 L70.4,54 L82,57"
        android:strokeColor="#FFFF8A80"
        android:strokeAlpha="0.9"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M24,78 L35.6,72 L47.2,74 L58.8,58 L70.4,60 L82,45"
        android:strokeColor="#FFF6C445"
        android:strokeAlpha="0.9"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M24,74 L35.6,64 L47.2,58 L58.8,46 L70.4,42 L82,31"
        android:strokeColor="#FF8FE7E4"
        android:strokeAlpha="0.9"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Portfolio index: the weighted aggregate of everything above -->
    <path
        android:pathData="M24,75 L35.6,71 L47.2,66 L58.8,57 L70.4,52 L82,44"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Optimum marker at the head of the index line -->
    <path
        android:pathData="M82,44m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M82,44m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#FF0D7377" />
</vector>
