<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/optimize_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- ======================== CAPTION SECTION ============================== -->

	<TextView
		android:id="@+id/tvTitle"
		style="@style/Widget.PortfolioOptimizerClassic.Caption"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="@string/optimize_title"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<!-- ======================== CONTENT SECTION ============================== -->

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/graphCard"
		style="@style/Widget.PortfolioOptimizerClassic.Card"
		android:layout_width="0dp"
		android:layout_height="280dp"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="4dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/tvTitle">

		<de.mm.portfoliooptimizerclassic.PortfolioGraphView
			android:id="@+id/optimizeGraph"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@color/graphBackgroundColor"
			android:padding="8dp" />

	</com.google.android.material.card.MaterialCardView>

	<!-- Spinner shown while the optimisation runs off the UI thread -->
	<ProgressBar
		android:id="@+id/optimizeProgress"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:indeterminateTint="@color/primaryColor"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="@id/graphCard"
		app:layout_constraintEnd_toEndOf="@id/graphCard"
		app:layout_constraintStart_toStartOf="@id/graphCard"
		app:layout_constraintTop_toTopOf="@id/graphCard" />

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/slidersCard"
		style="@style/Widget.PortfolioOptimizerClassic.Card"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="4dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/graphCard">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="16dp"
			android:paddingVertical="8dp">

			<TextView
				android:id="@+id/tvVarLabel"
				style="@style/TextAppearance.PortfolioOptimizerClassic.Label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/optimize_var_label_zero" />

			<SeekBar
				android:id="@+id/sbReduceVariance"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:max="100"
				android:paddingVertical="6dp"
				android:progressTint="@color/primaryColor"
				android:thumbTint="@color/primaryColor" />

			<TextView
				android:id="@+id/tvExpLabel"
				style="@style/TextAppearance.PortfolioOptimizerClassic.Label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/optimize_exp_label_zero" />

			<SeekBar
				android:id="@+id/sbMaxExpectation"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:max="100"
				android:paddingVertical="6dp"
				android:progressTint="@color/secondaryColor"
				android:thumbTint="@color/secondaryColor" />

			<TextView
				android:id="@+id/tvMddLabel"
				style="@style/TextAppearance.PortfolioOptimizerClassic.Label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/optimize_mdd_label_zero" />

			<SeekBar
				android:id="@+id/sbMinDrawdown"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:max="100"
				android:paddingVertical="6dp"
				android:progressTint="#F59E0B"
				android:thumbTint="#F59E0B" />

		</LinearLayout>

	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/quantitiesCard"
		style="@style/Widget.PortfolioOptimizerClassic.Card"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginBottom="4dp"
		app:layout_constraintBottom_toTopOf="@+id/btnBack"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/slidersCard">

		<ScrollView
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<TableLayout
				android:id="@+id/optimizeTable"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:stretchColumns="0" />

		</ScrollView>

	</com.google.android.material.card.MaterialCardView>

	<!-- ======================== NAVIGATION SECTION =========================== -->

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btnBack"
		style="@style/Widget.PortfolioOptimizerClassic.Button.Tonal"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="8dp"
		android:text="@string/common_back_to_portfolio"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
